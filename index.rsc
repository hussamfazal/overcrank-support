13:["$","div",null,{"className":"faq-list","id":"support","children":[[["$","details","Which cameras work with Overcrank?",{"children":[["$","summary",null,{"children":"Which cameras work with Overcrank?"}],["$","p",null,{"children":"Built and hardware-tested for GoPro MISSION 1 Pro. HERO9 Black and later are built against GoPro’s published Open GoPro protocol but not yet tested on hardware; exact settings depend on camera and firmware."}]]}],["$","details","Do I need my iPhone with me?",{"children":[["$","summary",null,{"children":"Do I need my iPhone with me?"}],["$","p",null,{"children":"Not for core Watch controls — Apple Watch talks directly to the camera over Bluetooth. iPhone adds Live Monitor, media tools, preset building, and Multi-Cam."}]]}],["$","details","What devices and software do I need?",{"children":[["$","summary",null,{"children":"What devices and software do I need?"}],["$","p",null,{"children":"An iPhone on iOS 17 or later and an Apple Watch on watchOS 10 or later."}]]}],["$","details","What data does Overcrank collect?",{"children":[["$","summary",null,{"children":"What data does Overcrank collect?"}],["$","p",null,{"children":"None. No accounts, no analytics, no servers. Camera traffic stays between your devices and the camera."}]]}]],["$","p",null,{"className":"support-line","children":["Questions or bugs? Email"," ",["$","a",null,{"href":"mailto:support@overcrank.ca","children":"support@overcrank.ca"}],"."]}]]}]
