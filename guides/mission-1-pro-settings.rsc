d:Tb02,{"@context":"https://schema.org","@graph":[{"@type":"TechArticle","@id":"https://overcrank.ca/guides/mission-1-pro-settings/#article","headline":"Best GoPro MISSION 1 Pro settings, explained","description":"The best MISSION 1 Pro video settings for everyday, slow motion, cinematic and low light, plus what every setting does and where to start.","url":"https://overcrank.ca/guides/mission-1-pro-settings/","mainEntityOfPage":"https://overcrank.ca/guides/mission-1-pro-settings/","image":["https://overcrank.ca/guides/og-settings.jpg","https://overcrank.ca/guides/mission-1-pro-ev-comp.webp"],"datePublished":"2026-09-26","dateModified":"2026-09-26","inLanguage":"en","author":{"@type":"Person","name":"Hussam Fazal","url":"https://www.youtube.com/@madebyhussam"},"publisher":{"@type":"Organization","name":"Overcrank","url":"https://overcrank.ca","logo":"https://overcrank.ca/overcrank/app-icon-256.png"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Overcrank","item":"https://overcrank.ca/"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://overcrank.ca/guides/"},{"@type":"ListItem","position":3,"name":"Best GoPro MISSION 1 Pro settings, explained","item":"https://overcrank.ca/guides/mission-1-pro-settings/"}]},{"@type":"VideoObject","name":"GoPro MISSION 1 Pro settings on Apple Watch","description":"Scrolling a MISSION 1 Pro's color, shutter, motion blur, EV Comp and white balance settings on Apple Watch. Real footage.","thumbnailUrl":"https://overcrank.ca/guides/mission-1-pro-settings-scroll-poster.webp","uploadDate":"2026-09-26","duration":"PT5S","contentUrl":"https://overcrank.ca/guides/mission-1-pro-settings-scroll.mp4"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are the best MISSION 1 Pro settings?","acceptedAnswer":{"@type":"Answer","text":"For everyday video: 4K, 30 fps, Linear lens, HyperSmooth Auto Boost, Natural colour, and Auto for shutter, ISO and white balance. Change one thing at a time from there."}},{"@type":"Question","name":"What are the best MISSION 1 Pro slow motion settings?","acceptedAnswer":{"@type":"Answer","text":"Raise the frame rate: 120 or 240 fps at 4K 16:9, or up to 480 fps at 1080p or 1440p. GoPro says 240 fps still plays smoothly slowed down 8 times."}},{"@type":"Question","name":"What are the best MISSION 1 Pro cinematic settings?","acceptedAnswer":{"@type":"Answer","text":"24 or 30 fps, a fixed shutter at about double the frame rate, a fixed white balance, and Cinematic colour, or GP-Log2 if you'll grade."}},{"@type":"Question","name":"What are the best MISSION 1 Pro low light settings?","acceptedAnswer":{"@type":"Answer","text":"Use the Low Light mode or 24 to 30 fps, and avoid GP-Log2: GoPro limits ISO to 400 in Log and doesn't recommend it for darker scenes."}}]}]}1:["$","article",null,{"className":"g-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],[["$","nav",null,{"className":"g-crumbs","aria-label":"Breadcrumb","children":["$","ol",null,{"children":[["$","li",null,{"children":["$","a",null,{"href":"/","children":"Overcrank"}]}],[["$","li",null,{"children":["$","a",null,{"href":"/guides/","children":"Guides"}]}],["$","li",null,{"aria-current":"page","children":"Best GoPro MISSION 1 Pro settings, explained"}]]]}]}],["$","header",null,{"className":"g-hero","children":[["$","div",null,{"className":"g-hero-copy","children":["$Le","$Lf"]}],"$L10","$L11"]}]],"$L12",["$L13","$L14","$L15"],"$L16","$L17","$L18","$L19"]}]
