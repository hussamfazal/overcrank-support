11:["$","section",null,{"className":"g-section","aria-labelledby":"action-button","children":[["$","h2",null,{"id":"action-button","children":"What about the Action button?"}],["$","p",null,{"children":"Overcrank adds Start Recording, Stop Recording and Tag HiLight actions to Shortcuts. You can put a Shortcut built from one of them on the Ultra's Action button, but it only works once Overcrank is already connected to the camera, and it opens the app as it runs. We tested it, and we don't lead with it: the record button in the app is quicker and more dependable."}]]}]
