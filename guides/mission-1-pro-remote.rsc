d:T11e7,{"@context":"https://schema.org","@graph":[{"@type":"TechArticle","@id":"https://overcrank.ca/guides/mission-1-pro-remote/#article","headline":"GoPro MISSION 1 Pro remote: every way to control it","description":"Every way to control a MISSION 1 Pro hands-free: The Remote, Shutter Remote, Quik, voice and Apple Watch. Range, prices and what each one does.","url":"https://overcrank.ca/guides/mission-1-pro-remote/","mainEntityOfPage":"https://overcrank.ca/guides/mission-1-pro-remote/","image":["https://overcrank.ca/guides/og-record.jpg","https://overcrank.ca/guides/apple-watch-gopro-check-framing.webp"],"datePublished":"2026-10-05","dateModified":"2026-10-05","inLanguage":"en","author":{"@type":"Person","name":"Hussam Fazal","url":"https://www.youtube.com/@madebyhussam"},"publisher":{"@type":"Organization","name":"Overcrank","url":"https://overcrank.ca","logo":"https://overcrank.ca/overcrank/app-icon-256.png"}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Overcrank","item":"https://overcrank.ca/"},{"@type":"ListItem","position":2,"name":"Guides","item":"https://overcrank.ca/guides/"},{"@type":"ListItem","position":3,"name":"GoPro MISSION 1 Pro remote: every way to control it","item":"https://overcrank.ca/guides/mission-1-pro-remote/"}]},{"@type":"VideoObject","name":"How to Control a GoPro with Apple Watch (2026)","description":"Is there a GoPro Apple Watch app? GoPro removed its own and Quik doesn't have one. How to control a GoPro with your Apple Watch in 2026: set it up in 3 steps, then everything the watch can do. Tested on a MISSION 1 Pro.","thumbnailUrl":"https://i.ytimg.com/vi/pIC41nls9aU/maxresdefault.jpg","uploadDate":"2026-10-03","duration":"PT1M48S","embedUrl":"https://www.youtube.com/embed/pIC41nls9aU","url":"https://www.youtube.com/watch?v=pIC41nls9aU","hasPart":[{"@type":"Clip","name":"How to control a GoPro with Apple Watch","startOffset":0,"endOffset":7,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=0s"},{"@type":"Clip","name":"Is there a GoPro Apple Watch app?","startOffset":7,"endOffset":18,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=7s"},{"@type":"Clip","name":"How to connect a GoPro to Apple Watch (3 steps)","startOffset":18,"endOffset":46,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=18s"},{"@type":"Clip","name":"Using Apple Watch as a GoPro remote","startOffset":46,"endOffset":68,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=46s"},{"@type":"Clip","name":"Change GoPro settings from Apple Watch","startOffset":68,"endOffset":83,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=68s"},{"@type":"Clip","name":"Free vs Pro, and which GoPros work","startOffset":83,"endOffset":108,"url":"https://www.youtube.com/watch?v=pIC41nls9aU&t=83s"}]},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does The Remote work with the MISSION 1 Pro?","acceptedAnswer":{"@type":"Answer","text":"Yes. GoPro lists the MISSION 1 Pro, MISSION 1 and MISSION 1 Pro ILS as compatible with The Remote and with the Waterproof Shutter Remote."}},{"@type":"Question","name":"What is the range of a GoPro remote on the MISSION 1 Pro?","acceptedAnswer":{"@type":"Answer","text":"GoPro rates The Remote at up to 60 m (196 ft) and the Waterproof Shutter Remote at up to 20 m (65 ft), both in optimal conditions. GoPro adds that range can drop when the camera records at higher resolutions and frame rates."}},{"@type":"Question","name":"How much is a MISSION 1 Pro remote?","acceptedAnswer":{"@type":"Answer","text":"On gopro.com (5 October 2026), The Remote is US $84.99 and the Waterproof Shutter Remote is US $59.99. GoPro Premium subscribers see $49.99 and $47.99."}},{"@type":"Question","name":"Can I control a MISSION 1 Pro with an Apple Watch?","acceptedAnswer":{"@type":"Answer","text":"Yes, with a third-party app. GoPro no longer makes a watch app. Overcrank is tested on the MISSION 1 Pro: record, modes and battery and card status are free, and the camera's settings and a framing preview are in Pro."}},{"@type":"Question","name":"Does Overcrank work with the MISSION 1 Pro ILS?","acceptedAnswer":{"@type":"Answer","text":"It isn't tested on the ILS yet. Overcrank is hardware-tested on the MISSION 1 Pro only, so that's the one camera we can vouch for."}},{"@type":"Question","name":"Can I start a MISSION 1 Pro recording with my voice?","acceptedAnswer":{"@type":"Answer","text":"Yes. MISSION 1 series cameras take voice commands to start and stop recording, take photos and change modes, as long as the camera can hear you over wind and engine noise."}}]}]}1:["$","article",null,{"className":"g-page","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$d"}}],"$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}]
