10:["$","section",null,{"className":"g-section","aria-labelledby":"range","children":[["$","h2",null,{"id":"range","children":"MISSION 1 Pro remote range"}],["$","p",null,{"children":["GoPro rates ",["$","a",null,{"href":"https://gopro.com/en/us/shop/mounts-accessories/the-remote/ARMTE-003.html","children":"The Remote"}]," at up to 60 m (196 ft) and the"," ",["$","a",null,{"href":"https://gopro.com/en/us/shop/mounts-accessories/waterproof-shutter-remote/ARMTE-004-master.html","children":"Waterproof Shutter Remote"}]," at up to 20 m (65 ft). Both figures are for optimal conditions. GoPro also warns that range can drop when the camera records at higher resolutions and frame rates, which is how most people shoot a MISSION 1 Pro."]}],["$","p",null,{"children":"An Apple Watch talks to the camera over Bluetooth too, so treat it like the remotes: it works best with the camera in sight, on your helmet, bars or a nearby mount. We don't publish a range figure for Overcrank because we haven't measured one."}]]}]
11:["$","section",null,{"className":"g-section","aria-labelledby":"watch","children":[["$","h2",null,{"id":"watch","children":"Use your Apple Watch as a MISSION 1 Pro remote"}],["$","p",null,{"children":"If you already wear an Apple Watch, it can do most of what The Remote does. Overcrank connects to the MISSION 1 Pro over Bluetooth and puts the record button, mode switch and the camera's battery and card status on your wrist, with no iPhone needed for those. Pro (US $9.99, once) adds the camera's settings and a framing preview relayed from your iPhone."}],["$","div",null,{"className":"g-split","children":[["$","div",null,{"className":"g-frame","children":["$","img",null,{"src":"/guides/apple-watch-gopro-status.webp","alt":"Overcrank status page: battery 99%, SD card 248.75 GB, 1h 57m recording time, GPS locked","width":720,"height":720,"loading":"lazy","fetchPriority":"$undefined","decoding":"async"}]}],["$","div",null,{"className":"g-frame","children":["$","img",null,{"src":"/guides/apple-watch-gopro-check-framing.webp","alt":"Overcrank Check Framing on Apple Watch, noting it works with the iPhone locked","width":720,"height":720,"loading":"lazy","fetchPriority":"$undefined","decoding":"async"}]}]]}],["$","p",null,{"children":[["$","a",null,{"href":"/guides/control-gopro-with-apple-watch/","children":"How to connect a GoPro to Apple Watch"}]," ","takes 3 steps."]}]]}]
